# =============================================================================
#  BERKAS INI DILACAK GIT. Jangan pernah mengisinya dengan nilai sungguhan.
#  Salin jadi .env (diabaikan git), lalu isi .env-nya.
#
#  Di Vercel, nilai yang sama diisi di Project → Settings → Environment Variables,
#  di project v2 — BUKAN di project v1.
# =============================================================================

# 1) Spreadsheet KHUSUS v2: buat baru, biarkan kosong.
#    Jangan isi dengan spreadsheet v1, produksi maupun staging.
#    Boleh ID-nya saja, boleh juga seluruh URL.
SPREADSHEET_ID=

# 2) Service account BARU khusus v2 — bukan akun task-tracker@… milik v1.
#    Kuota baca Sheets (60/menit) dihitung per service account; akun bersama
#    berarti uji coba v2 memakan jatah v1.
#
#    Vercel: isi GOOGLE_SERVICE_ACCOUNT_JSON dengan SELURUH isi berkas kunci, satu baris.
#    Lokal : lebih mudah menunjuk berkasnya. Simpan di luar folder repo kalau bisa.
#    Kalau keduanya terisi, GOOGLE_SERVICE_ACCOUNT_JSON yang menang.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# 3) PIN gerbang API. Kosong = semua aksi ditolak (gerbang tertutup, bukan terbuka).
ACCESS_PIN=

# 4) Rahasia penanda tangan cookie sesi. Acak, minimal 32 karakter. Buat dengan:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    Mengganti nilai ini (atau ACCESS_PIN) mengeluarkan semua orang dari sesinya.
SESSION_SECRET=

# 4b) (Opsional) PIN mode Dev (0.13.0): tekan-tahan logo ProductTrack ±2 detik, lalu isi PIN
#     ini. Kosong = mode Dev tertutup (tak ada PIN bawaan, berbeda dengan v1). Bedakan dari
#     ACCESS_PIN. Mengganti nilai ini membatalkan semua sesi Dev; sesi biasanya tetap jalan.
DEV_PIN=

# 4c) (Opsional) Agen AI Ali (2.17.0): kunci agen, acak, minimal 32 karakter (buat seperti
#     SESSION_SECRET). Nilai yang sama diisi di agen/.env di komputer yang menjalankan Agent
#     Office. Kosong = agen tertutup. AGEN_PROFIL = profil agen, bawaannya ali.
AGEN_KUNCI=
# AGEN_PROFIL=ali

# 5) (Opsional, hanya lokal) Port server, dan HOST=0.0.0.0 supaya bisa dibuka
#    dari komputer lain di jaringan kantor. Bawaan: 127.0.0.1:3000.
# PORT=3000
# HOST=0.0.0.0
